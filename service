#!/usr/bin/env bash
set -euo pipefail

# Persistent local stack for an existing Codex conversation:
# Kokoro -> event relay -> supervised duplex voice worker.
#
# This process intentionally does not launch another Codex TUI. It attaches to
# the supplied authoritative thread through the managed app-server and can live
# in a tmux service window while the interactive harness is reattached.

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(python "$script_dir/repository_layout.py" --root)
release_py=$(python "$script_dir/repository_layout.py" voice/release.py)
if [ "${1:-}" = "--check" ]; then
    export ZERO_VOICE_CHECK_ONLY=1
    shift
fi
thread="${1:-${ZERO_VOICE_THREAD:-${CODEX_THREAD_ID:-}}}"
if [ -z "$thread" ]; then
    echo "usage: voice/service [--check] THREAD_ID" >&2
    exit 2
fi
skip_kokoro="${ZERO_VOICE_SKIP_KOKORO_CHECK:-${ZERO_STACK_SKIP_KOKORO_CHECK:-0}}"

state="${ZERO_VOICE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zer0-voice}"
release_state="${ZERO_VOICE_RELEASE_STATE:-$state/releases}"

resolve_bundle() {
    python "$release_py" \
        --state "$release_state" resolve --path
}

# Compatibility inspection must remain safe while production owns its lock.
# It performs only verified immutable reads: no state directory, lock, daemon,
# dependency, microphone, or socket is created.
if [ "${ZERO_VOICE_CHECK_ONLY:-0}" = 1 ]; then
    if ! bundle_root=$(resolve_bundle); then
        echo "Voice release failed managed-production compatibility" >&2
        exit 78
    fi
    echo "Voice release compatibility check passed: ${bundle_root##*/}" >&2
    exit 0
fi

mkdir -p "$state"

# Prevent two microphones from submitting the same utterance. The flock parent
# owns the lock, while --close keeps app-server, Kokoro, relay, and duplex
# children from inheriting it after this supervisor exits.
if [ "${ZERO_VOICE_LOCKED:-0}" != 1 ]; then
    export ZERO_VOICE_LOCKED=1
    export ZERO_VOICE_THREAD="$thread"
    exec flock -n --close -E 75 "$state/service-v2.lock" "$0"
fi

# Resolve and verify the immutable production release once. Every worker
# generation in this supervisor uses that pinned bundle; dirty worktree edits
# cannot enter through watchdog restarts. Promotion never signals this process.
if ! bundle_root=$(resolve_bundle); then
    echo "Voice release failed managed-production compatibility" >&2
    exit 78
fi
echo "Voice release pinned: ${bundle_root##*/}" >&2
runtime_manager="$bundle_root/voice/runtime_manager.py"

voice_pid=
relay_pid=
cleanup() {
    if [ -n "$voice_pid" ]; then
        kill "$voice_pid" 2>/dev/null || true
        wait "$voice_pid" 2>/dev/null || true
    fi
    if [ -n "$relay_pid" ]; then
        kill "$relay_pid" 2>/dev/null || true
        wait "$relay_pid" 2>/dev/null || true
    fi
}
trap 'cleanup; exit 0' INT TERM HUP
trap cleanup EXIT

codex app-server daemon start >/dev/null

kokoro_url="${ZERO_KOKORO_URL:-http://127.0.0.1:8880}"
kokoro_launcher="${ZERO_KOKORO_LAUNCHER:-/workspace/kokoro-tts/kokoro.sh}"
if [[ "$skip_kokoro" == "0" ]] && ! curl -fsS --max-time 1 "$kokoro_url/health" >/dev/null 2>&1; then
    if [ ! -x "$kokoro_launcher" ]; then
        echo "Kokoro is offline and launcher is unavailable: $kokoro_launcher" >&2
        exit 1
    fi
    "$kokoro_launcher" start
    attempts=0
    until curl -fsS --max-time 1 "$kokoro_url/health" >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 600 ]; then
            echo "Kokoro did not become ready at $kokoro_url" >&2
            exit 1
        fi
        sleep 0.1
    done
fi
echo "Kokoro ready" >&2

relay_url="${ZERO_RELAY_URL:-http://127.0.0.1:8787}"
if ! curl -fsS --max-time 1 "$relay_url/healthz" >/dev/null 2>&1; then
    daemon="$root/core/target/release/zer0d"
    if [ ! -x "$daemon" ]; then
        cargo build --release --manifest-path "$root/core/Cargo.toml" --bin zer0d
    fi
    python "$root/integration/relay.py" \
        --events "$state/events.jsonl" \
        --zer0d "$daemon" \
        >"$state/relay.log" 2>&1 &
    relay_pid=$!
    attempts=0
    until curl -fsS --max-time 1 "$relay_url/healthz" >/dev/null 2>&1; do
        if ! kill -0 "$relay_pid" 2>/dev/null; then
            wait "$relay_pid" || true
            echo "event relay exited before readiness; see $state/relay.log" >&2
            exit 1
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 100 ]; then
            echo "event relay readiness timed out; see $state/relay.log" >&2
            exit 1
        fi
        sleep 0.1
    done
fi
echo "PM event relay ready" >&2

# This stable owner keeps the public control socket and authoritative thread
# while immutable duplex generations warm, switch, recover, and roll back.
workspace_routing=(--workspace-routing)
if [[ "${ZERO_VOICE_WORKSPACE_ROUTING:-1}" == 0 ]]; then
    workspace_routing=(--no-workspace-routing)
fi
python "$runtime_manager" "$thread" \
    --root "$root" \
    --state "$state" \
    --release-state "$release_state" \
    --kokoro-url "$kokoro_url" \
    --kokoro-launcher "$kokoro_launcher" \
    --relay-url "$relay_url" \
    --input "${ZERO_VOICE_INPUT:-default}" \
    --output "${ZERO_VOICE_OUTPUT:-effect_input.aural_evolution}" \
    --mic-mode "${ZERO_VOICE_MIC_MODE:-continuous}" \
    --notification-mode "${ZERO_VOICE_NOTIFICATION_MODE:-conversational}" \
    --live-model "${ZERO_VOICE_LIVE_MODEL:-gpt-5.6-luna}" \
    --live-effort "${ZERO_VOICE_LIVE_EFFORT:-low}" \
    --live-timeout "${ZERO_VOICE_LIVE_TIMEOUT:-35}" \
    --barge-in "${ZERO_VOICE_BARGE_IN:-sustained}" \
    "${workspace_routing[@]}" \
    --keyboard-indicator "${ZERO_WOOTING_INDICATOR:-none}" \
    --metrics "$root/bench/voice-history.jsonl" \
    --debug-events "$state/voice-debug.jsonl" &
voice_pid=$!
wait "$voice_pid"
