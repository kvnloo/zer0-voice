#!/bin/sh
set -eu

# Both the TUI and local voice bridge must use the same managed app-server.
# This is the launch boundary that makes voice turns visible in the harness.
codex app-server daemon start >/dev/null

voice=0
if [ "${1:-}" = "--voice" ]; then
    voice=1
    shift
fi

if [ "${1:-}" = "--new" ]; then
    if [ "$voice" -eq 1 ]; then
        echo "--voice requires an existing THREAD_ID" >&2
        exit 2
    fi
    shift
    exec codex --remote unix:// "$@"
fi

thread="${1:-${CODEX_THREAD_ID:-}}"
if [ -z "$thread" ]; then
    echo "usage: voice/codex-harness [--voice] THREAD_ID" >&2
    echo "       voice/codex-harness --new [-C DIRECTORY]" >&2
    exit 2
fi

shift || true
if [ "$voice" -eq 0 ]; then
    exec codex --remote unix:// resume "$thread" "$@"
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
state="${XDG_STATE_HOME:-$HOME/.local/state}/zer0-voice"
log="$state/$thread.log"
mkdir -p "$(dirname -- "$log")"
relay_pid=
supervisor_pid=
cleanup() {
    if [ -n "$supervisor_pid" ]; then
        kill "$supervisor_pid" 2>/dev/null || true
        wait "$supervisor_pid" 2>/dev/null || true
    fi
    if [ -n "$relay_pid" ]; then
        kill "$relay_pid" 2>/dev/null || true
        wait "$relay_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM HUP

kokoro_url="${ZERO_KOKORO_URL:-http://127.0.0.1:8880}"
kokoro_launcher="${ZERO_KOKORO_LAUNCHER:-/workspace/kokoro-tts/kokoro.sh}"
if ! curl -fsS --max-time 1 "$kokoro_url/health" >/dev/null 2>&1; then
    if [ ! -x "$kokoro_launcher" ]; then
        echo "Kokoro is offline and launcher is unavailable: $kokoro_launcher" >&2
        exit 1
    fi
    "$kokoro_launcher" start
    attempts=0
    until curl -fsS --max-time 1 "$kokoro_url/health" >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 300 ]; then
            echo "Kokoro did not become ready at $kokoro_url; run: $kokoro_launcher log" >&2
            exit 1
        fi
        sleep 0.1
    done
fi

if ! curl -fsS --max-time 1 http://127.0.0.1:8787/healthz >/dev/null 2>&1; then
    if [ ! -x "$root/core/target/release/zer0d" ]; then
        cargo build --release --manifest-path "$root/core/Cargo.toml" --bin zer0d
    fi
    python "$root/integration/relay.py" \
        --events "$state/events.jsonl" \
        --zer0d "$root/core/target/release/zer0d" \
        >"$state/relay.log" 2>&1 &
    relay_pid=$!
    attempts=0
    until curl -fsS --max-time 1 http://127.0.0.1:8787/healthz >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 20 ]; then
            echo "event relay did not become ready; see $state/relay.log" >&2
            exit 1
        fi
        sleep 0.1
    done
fi

supervise_voice() (
    voice_child=
    stop_voice() {
        if [ -n "$voice_child" ]; then
            kill "$voice_child" 2>/dev/null || true
            wait "$voice_child" 2>/dev/null || true
        fi
    }
    trap 'stop_voice; exit 0' INT TERM HUP
    trap stop_voice EXIT
    backoff=1
    while :; do
        started=$(date +%s)
        "$root/voice/duplex" \
            --session "$thread" \
            --app-server shared \
            --no-workspace-routing \
            --kokoro-url "$kokoro_url" \
            --input "${ZERO_VOICE_INPUT:-Blue Snowball}" \
            --output "${ZERO_VOICE_OUTPUT:-effect_input.aural_evolution}" \
            --mic-mode "${ZERO_VOICE_MIC_MODE:-continuous}" \
            --notification-mode "${ZERO_VOICE_NOTIFICATION_MODE:-conversational}" \
            --keyboard-indicator "${ZERO_WOOTING_INDICATOR:-none}" \
            --metrics "$root/bench/voice-history.jsonl" \
            --debug-events "$state/voice-debug.jsonl" \
            >>"$log" 2>&1 &
        voice_child=$!
        if wait "$voice_child"; then
            status=0
        else
            status=$?
        fi
        voice_child=
        uptime=$(($(date +%s) - started))
        if [ "$uptime" -ge 60 ]; then
            backoff=1
        fi
        echo "voice exited status=$status; restarting in ${backoff}s" >&2
        sleep "$backoff"
        if [ "$backoff" -lt 8 ]; then
            backoff=$((backoff * 2))
        fi
    done
)

supervise_voice &
supervisor_pid=$!

startup_timeout="${ZERO_VOICE_STARTUP_TIMEOUT_SECONDS:-30}"
attempts=0
max_attempts=$((startup_timeout * 4))
while ! "$root/voice/control.py" status >/dev/null 2>&1; do
    if ! kill -0 "$supervisor_pid" 2>/dev/null; then
        wait "$supervisor_pid" 2>/dev/null || true
        echo "voice supervisor exited before readiness; see $log" >&2
        exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge "$max_attempts" ]; then
        echo "voice readiness timed out after ${startup_timeout}s; see $log" >&2
        exit 1
    fi
    sleep 0.25
done
echo "voice ready: continuous capture and control handshake active" >&2

codex --remote unix:// resume "$thread" "$@"
